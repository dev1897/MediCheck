    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "pg-mem": "^3.0.14"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
