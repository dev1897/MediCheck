# Copie este archivo como .env y ajuste los valores.

PORT=3000
NODE_ENV=development

# Base de datos: "memoria" (PostgreSQL emulado, ideal para pruebas) o "postgres"
DB_MODO=memoria
# DATABASE_URL=postgres://medicheck:medicheck@localhost:5432/medicheck

# Seguridad (obligatorio cambiarlo en producción)
JWT_SECRETO=cambie-este-secreto-en-produccion
JWT_EXPIRA=12h

# Reglas de negocio
ZONA_HORARIA=-05:00
TOLERANCIA_POR_DEFECTO_MIN=30
HORIZONTE_DIAS=7
CRON_PLANIFICADOR=* * * * *

# Notificaciones push: "simulado" o "fcm"
# Para "fcm": npm install firebase-admin y defina GOOGLE_APPLICATION_CREDENTIALS
PUSH_MODO=simulado

# Correo: "simulado" (guarda los mensajes en CARPETA_BUZON) o "smtp"
CORREO_MODO=simulado
CARPETA_BUZON=buzon
# SMTP_HOST=smtp.gmail.com
# SMTP_PUERTO=587
# SMTP_USUARIO=
# SMTP_CONTRASENA=
# SMTP_REMITENTE=MediCheck <no-responder@medicheck.app>

# Endpoints de simulación (/api/simulacion). Desactivar en producción.
SIMULACION=true

# Cargar datos de demostración al iniciar
SEED=false
